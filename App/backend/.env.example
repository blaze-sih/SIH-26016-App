# =============================================================
# LRVS Backend — Environment Variables Template
# Team BLAZE | SIH26016
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# =============================================================

# --- Server & Environment ---
# In Render, PORT is assigned dynamically by the platform
PORT=9000
NODE_ENV=production

# --- Database ---
# MongoDB Atlas Free Tier (M0) Connection URI
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/sih26016?retryWrites=true&w=majority

# --- Authentication ---
# Secure random string (min 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# --- CORS ---
# In production, set to your Render URL or * to allow browser access
CORS_ORIGIN=*

# --- Blockchain (SIH Prototype Mode) ---
# Set BLOCKCHAIN_MOCK=true to use the built-in mock engine
BLOCKCHAIN_MOCK=true
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS_LAND=
BLOCKCHAIN_CONTRACT_ADDRESS_APPROVAL=
BLOCKCHAIN_CONTRACT_ADDRESS_COMPENSATION=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_NETWORK=mock

# --- Document Storage ---
UPLOAD_DIR=uploads
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_PATH=storage/documents
MAX_FILE_SIZE_MB=20

# --- Rate Limiting & Logs ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
LOG_LEVEL=info

# --- Optional AI Service ---
# Leave empty or set to microservice URL if running
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=120000

# --- Optional Maps ---
GOOGLE_MAPS_API_KEY=
