<!-- Data Adder — New Land Acquisition Proposal Wizard -->
<div class="space-y-6 max-w-5xl mx-auto">

  <!-- Header Banner -->
  <div class="bg-white p-6 rounded-xl border border-[#E7EDEF] shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-[#207E85]/10 text-[#207E85] border border-[#207E85]/20">Stage 1 · Proposal</span>
        <h1 class="text-xl font-bold font-mono tracking-tight text-[#1A2A42]">New Land Acquisition Proposal</h1>
      </div>
      <p class="text-xs text-slate-500 mt-1">Register acquisition proposal, cadastral boundaries, ownership details, and upload source 7/12 extract for automated AI extraction.</p>
    </div>

    <div class="flex items-center gap-2">
      <a href="/land/requests" class="px-3.5 py-2 bg-white hover:bg-slate-50 border border-[#E7EDEF] text-slate-700 text-xs font-semibold rounded-lg shadow-sm transition">
        ← Cancel & Back
      </a>
    </div>
  </div>

  <% if (typeof errors !== 'undefined' && errors.general) { %>
    <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl text-xs flex items-center gap-2">
      <svg class="w-4 h-4 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span><%= errors.general %></span>
    </div>
  <% } %>

  <!-- Multi-step Form Wizard Container -->
  <form id="createLandForm" method="POST" action="/land/create" class="space-y-6">

    <!-- Stepper Navigation Header -->
    <div class="bg-white p-4 rounded-xl border border-[#E7EDEF] shadow-sm">
      <div class="grid grid-cols-4 gap-2 text-center text-xs">
        <div id="stepTab1" class="py-2 px-3 rounded-lg bg-[#207E85] text-white font-bold transition">
          1. Project Details
        </div>
        <div id="stepTab2" class="py-2 px-3 rounded-lg bg-slate-100 text-slate-600 font-medium transition">
          2. Cadastral & Area
        </div>
        <div id="stepTab3" class="py-2 px-3 rounded-lg bg-slate-100 text-slate-600 font-medium transition">
          3. Ownership & R&R
        </div>
        <div id="stepTab4" class="py-2 px-3 rounded-lg bg-slate-100 text-slate-600 font-medium transition">
          4. Documents & AI
        </div>
      </div>
    </div>

    <!-- STEP 1: Project Details -->
    <div id="step1" class="bg-white p-6 rounded-xl border border-[#E7EDEF] shadow-sm space-y-4">
      <h2 class="text-sm font-bold text-[#1A2A42] border-b border-[#E7EDEF] pb-2">
        Step 1: Project Identification & Location
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Project Name *</label>
          <input type="text" name="projectName" value="<%= (formData && formData.projectName) || 'Greenfield Expressway' %>" required
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg font-medium text-[#1A2A42] focus:ring-1 focus:ring-[#207E85] focus:outline-none" />
          <p class="text-[10px] text-slate-400 mt-1">E.g., Greenfield Expressway, Industrial Corridor</p>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Acquisition Purpose *</label>
          <input type="text" name="acquisitionPurpose" value="<%= (formData && formData.acquisitionPurpose) || 'National Highway 4-Lane Expansion' %>" required
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg font-medium text-[#1A2A42] focus:ring-1 focus:ring-[#207E85] focus:outline-none" />
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">State *</label>
          <select name="state" class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg text-[#1A2A42] focus:ring-1 focus:ring-[#207E85]">
            <option value="Maharashtra" selected>Maharashtra</option>
            <option value="Gujarat">Gujarat</option>
            <option value="Karnataka">Karnataka</option>
            <option value="Madhya Pradesh">Madhya Pradesh</option>
          </select>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">District *</label>
          <input type="text" name="district" value="<%= (formData && formData.district) || 'Nashik' %>" required
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg text-[#1A2A42] focus:ring-1 focus:ring-[#207E85]" />
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Taluka / Tehsil *</label>
          <input type="text" name="taluka" value="<%= (formData && formData.taluka) || 'Sinnar' %>" required
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg text-[#1A2A42] focus:ring-1 focus:ring-[#207E85]" />
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Village *</label>
          <input type="text" name="village" value="<%= (formData && formData.village) || 'Sinnar' %>" required
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg text-[#1A2A42] focus:ring-1 focus:ring-[#207E85]" />
        </div>
      </div>

      <div class="flex justify-end pt-3">
        <button type="button" onclick="goToStep(2)" class="px-5 py-2 bg-[#207E85] hover:bg-[#19656b] text-white text-xs font-semibold rounded-lg shadow-sm transition">
          Next: Cadastral Specs →
        </button>
      </div>
    </div>

    <!-- STEP 2: Cadastral Specs & Area -->
    <div id="step2" class="hidden bg-white p-6 rounded-xl border border-[#E7EDEF] shadow-sm space-y-4">
      <h2 class="text-sm font-bold text-[#1A2A42] border-b border-[#E7EDEF] pb-2">
        Step 2: Cadastral Specifications & Geolocation
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Survey Number / Gut No *</label>
          <input type="text" name="surveyNumber" value="<%= (formData && formData.surveyNumber) || '142/8' %>" required
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg font-mono font-bold text-[#1A2A42] focus:ring-1 focus:ring-[#207E85]" />
          <p class="text-[10px] text-slate-400 mt-1">E.g., 142/8, 118/2A</p>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Sub-Division / Hissa</label>
          <input type="text" name="subDivision" value="<%= (formData && formData.subDivision) || 'A' %>"
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg text-[#1A2A42] font-mono" />
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Khata Number</label>
          <input type="text" name="khataNumber" value="<%= (formData && formData.khataNumber) || 'KH-8821' %>"
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg text-[#1A2A42] font-mono" />
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Total Acquired Area *</label>
          <input type="number" step="0.01" name="areaTotal" value="<%= (formData && formData.areaTotal) || '45.2' %>" required
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg font-mono font-bold text-[#1A2A42]" />
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Area Unit</label>
          <select name="areaUnit" class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg text-[#1A2A42]">
            <option value="Ha" selected>Hectares (Ha)</option>
            <option value="Acre">Acres</option>
            <option value="Sq.m">Square Meters</option>
          </select>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Land Classification</label>
          <select name="landType" class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg text-[#1A2A42]">
            <option value="Agricultural" selected>Agricultural (Jirayat/Bagayat)</option>
            <option value="Commercial">Commercial / Industrial</option>
            <option value="Residential">Residential / Gaothan</option>
            <option value="Barren">Barren / Waste Land</option>
          </select>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Centroid Latitude</label>
          <input type="text" name="latitude" value="<%= (formData && formData.latitude) || '19.8512' %>"
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg font-mono text-[#1A2A42]" />
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Centroid Longitude</label>
          <input type="text" name="longitude" value="<%= (formData && formData.longitude) || '73.9921' %>"
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg font-mono text-[#1A2A42]" />
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Occupancy Class</label>
          <input type="text" name="occupancyClass" value="Bhogvatdar Class 1"
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg text-[#1A2A42]" />
        </div>
      </div>

      <div class="flex justify-between pt-3">
        <button type="button" onclick="goToStep(1)" class="px-4 py-2 border border-[#E7EDEF] text-slate-700 text-xs font-semibold rounded-lg hover:bg-slate-50">
          ← Back
        </button>
        <button type="button" onclick="goToStep(3)" class="px-5 py-2 bg-[#207E85] hover:bg-[#19656b] text-white text-xs font-semibold rounded-lg shadow-sm transition">
          Next: Ownership & R&R →
        </button>
      </div>
    </div>

    <!-- STEP 3: Ownership & R&R -->
    <div id="step3" class="hidden bg-white p-6 rounded-xl border border-[#E7EDEF] shadow-sm space-y-4">
      <h2 class="text-sm font-bold text-[#1A2A42] border-b border-[#E7EDEF] pb-2">
        Step 3: Ownership Title & Socio-Economic (R&R)
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Primary Land Owner Name *</label>
          <input type="text" name="landOwner" value="<%= (formData && formData.landOwner) || 'Ramesh Patil' %>" required
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg font-bold text-[#1A2A42] focus:ring-1 focus:ring-[#207E85]" />
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Father / Husband / Relative Name</label>
          <input type="text" name="fatherName" value="Tukaram Patil"
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg text-[#1A2A42]" />
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Owner Contact Number</label>
          <input type="text" name="contactNumber" value="9822012345"
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg font-mono text-[#1A2A42]" />
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Ownership Share</label>
          <input type="text" name="share" value="1/1"
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg font-mono text-[#1A2A42]" />
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Affected Families (R&R Metric)</label>
          <input type="number" name="affectedFamilies" value="1" min="0"
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg font-mono text-[#1A2A42]" />
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Displaced Families (Relocation Metric)</label>
          <input type="number" name="displacedFamilies" value="0" min="0"
                 class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg font-mono text-[#1A2A42]" />
        </div>
      </div>

      <div class="flex justify-between pt-3">
        <button type="button" onclick="goToStep(2)" class="px-4 py-2 border border-[#E7EDEF] text-slate-700 text-xs font-semibold rounded-lg hover:bg-slate-50">
          ← Back
        </button>
        <button type="button" onclick="goToStep(4)" class="px-5 py-2 bg-[#207E85] hover:bg-[#19656b] text-white text-xs font-semibold rounded-lg shadow-sm transition">
          Next: Documents & AI Extraction →
        </button>
      </div>
    </div>

    <!-- STEP 4: Documents & AI Extraction -->
    <div id="step4" class="hidden bg-white p-6 rounded-xl border border-[#E7EDEF] shadow-sm space-y-5">
      <h2 class="text-sm font-bold text-[#1A2A42] border-b border-[#E7EDEF] pb-2">
        Step 4: Title Deed Document & AI Verification Dispatch
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Source Document Type</label>
            <select name="documentType" class="w-full px-3 py-2 border border-[#E7EDEF] rounded-lg text-xs text-[#1A2A42]">
              <option value="712_EXTRACT" selected>7/12 Extract (Satbara Utara)</option>
              <option value="SALE_DEED">Registered Sale Deed (Kharidkhat)</option>
              <option value="MUTATION_ENTRY">Ferfar / Mutation Register</option>
              <option value="FORM_8A">Form 8A — Holding Register</option>
            </select>
          </div>

          <!-- Document Upload Box -->
          <div class="border-2 border-dashed border-[#C5E1E3] bg-[#F8FAFB] hover:bg-[#F3F8F9] rounded-xl p-6 text-center cursor-pointer transition"
               onclick="document.getElementById('demoDocUpload').click()">
            <input type="file" id="demoDocUpload" class="hidden" accept=".pdf,.jpg,.jpeg,.png" onchange="fileSelected(this)" />
            <div class="w-10 h-10 rounded-full bg-[#E8F3F4] text-[#207E85] flex items-center justify-center mx-auto mb-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
            </div>
            <p id="docUploadLabel" class="text-xs font-semibold text-[#1A2A42]">Click to attach 7/12 Extract PDF</p>
            <p class="text-[11px] text-slate-400 mt-0.5">Sample PDF: 7_12_Extract_142_8_Nashik.pdf</p>
          </div>
        </div>

        <!-- AI Engine Preview Box -->
        <div class="p-4 bg-[#F0F9FF] border border-[#BAE6FD] rounded-xl space-y-3 text-xs">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="font-bold text-[#0369A1]">AI Extraction Engine (Prototype Mode)</span>
          </div>
          <p class="text-[11px] text-[#0284C7] leading-relaxed">
            Upon creation, the multi-language OCR pipeline parses village, survey number, area, and owner entries. If OCR detects an anomaly (such as 142/3 vs 142/8), it flags low confidence for human verification.
          </p>
          <div class="bg-white p-3 rounded-lg border border-[#BAE6FD] space-y-1 font-mono text-[11px] text-slate-600">
            <div>✓ Extraction Engine: Multi-Lingual OCR (Marathi + English)</div>
            <div>✓ Confidence Threshold: 75% Auto-Flag</div>
            <div>✓ Security: SHA-256 Ledger Hash Anchor</div>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between pt-4 border-t border-[#E7EDEF]">
        <button type="button" onclick="goToStep(3)" class="px-4 py-2 border border-[#E7EDEF] text-slate-700 text-xs font-semibold rounded-lg hover:bg-slate-50">
          ← Back
        </button>
        <button type="submit" class="px-6 py-2.5 bg-[#207E85] hover:bg-[#19656b] text-white text-xs font-bold rounded-lg shadow-md transition flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span>Submit Acquisition Proposal & Initiate AI</span>
        </button>
      </div>
    </div>

  </form>

</div>

<script>
function goToStep(stepNum) {
  for (let i = 1; i <= 4; i++) {
    const stepEl = document.getElementById('step' + i);
    const tabEl = document.getElementById('stepTab' + i);
    if (i === stepNum) {
      stepEl.classList.remove('hidden');
      tabEl.className = 'py-2 px-3 rounded-lg bg-[#207E85] text-white font-bold transition';
    } else {
      stepEl.classList.add('hidden');
      tabEl.className = 'py-2 px-3 rounded-lg bg-slate-100 text-slate-600 font-medium transition cursor-pointer';
      tabEl.onclick = () => goToStep(i);
    }
  }
}

function fileSelected(input) {
  if (input.files && input.files[0]) {
    document.getElementById('docUploadLabel').textContent = 'Attached: ' + input.files[0].name;
    document.getElementById('docUploadLabel').className = 'text-xs font-bold text-emerald-700';
  }
}
</script>
