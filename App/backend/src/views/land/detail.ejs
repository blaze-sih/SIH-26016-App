<!-- LRVS Official Land Case Dossier (SIH26016) -->
<div class="space-y-6">

  <!-- 1. Header Banner -->
  <div class="bg-white p-6 rounded-xl border border-[#E7EDEF] shadow-sm flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2.5 flex-wrap">
        <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-[#207E85]/10 text-[#207E85] border border-[#207E85]/20">Dossier ID</span>
        <h1 class="text-xl font-bold font-mono tracking-tight text-[#1A2A42]"><%= record.requestId %></h1>
        <%- include('../partials/status-badge', { status: record.acquisitionStatus || record.status }) %>
      </div>
      <p class="text-base font-bold text-[#1A2A42] mt-1"><%= record.projectName || 'Land Acquisition Project' %></p>
      <p class="text-xs text-slate-500 mt-0.5">
        Survey No: <strong class="font-mono text-slate-800"><%= record.surveyNumber || '142/8' %></strong> • 
        Village: <strong class="text-slate-800"><%= record.village || 'Sinnar' %></strong> • 
        Taluka: <strong class="text-slate-800"><%= record.taluka || 'Sinnar' %></strong> • 
        District: <strong class="text-slate-800"><%= record.district || 'Nashik' %></strong> (<%= record.state || 'Maharashtra' %>) •
        Area: <strong class="text-slate-800"><%= record.area?.total || 45.2 %> <%= record.area?.unit || 'Ha' %></strong>
      </p>
    </div>

    <!-- Action Bar -->
    <div class="flex items-center gap-2 flex-wrap">
      <a href="/land/<%= record.requestId %>/field-mode" class="px-3.5 py-2 bg-[#F0FDF4] hover:bg-emerald-100 text-emerald-800 border border-emerald-300 text-xs font-bold rounded-lg shadow-sm transition flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
        <span>Field Survey App</span>
      </a>

      <% if (['VERIFICATION_OFFICER', 'SUPER_ADMIN'].includes(currentUser.role) && ['PENDING_VERIFICATION', 'AI_PROCESSED', 'AI_FAILED', 'SUBMITTED'].includes(record.acquisitionStatus)) { %>
        <a href="/verification/<%= record.requestId %>" class="px-3.5 py-2 bg-[#207E85] hover:bg-[#19656b] text-white text-xs font-bold rounded-lg shadow-sm transition flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          <span>Data Checker</span>
        </a>
      <% } %>

      <a href="/land/requests" class="px-3.5 py-2 bg-white hover:bg-slate-50 border border-[#E7EDEF] text-slate-700 text-xs font-semibold rounded-lg shadow-sm transition">
        ← All Cases
      </a>
    </div>
  </div>

  <!-- Flash Messages -->
  <% if (success) { %>
    <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-xs flex items-center gap-2">
      <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      <span class="font-medium">Action successful: <%= success.replace(/_/g, ' ') %></span>
    </div>
  <% } %>
  <% if (errorMsg) { %>
    <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl text-xs flex items-center gap-2">
      <svg class="w-4 h-4 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span class="font-medium"><%= errorMsg %></span>
    </div>
  <% } %>

  <!-- 2. Next Action Prompt Card (Role-Specific) -->
  <% if (nextAction) { %>
  <div class="p-5 rounded-xl border <%= nextAction.canAct ? 'bg-[#F0F9FF] border-[#BAE6FD]' : 'bg-[#F8FAFB] border-[#E7EDEF]' %> shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full <%= nextAction.canAct ? 'bg-[#0284C7] animate-ping' : 'bg-slate-400' %>"></span>
        <span class="text-xs font-bold uppercase tracking-wider <%= nextAction.canAct ? 'text-[#0369A1]' : 'text-slate-500' %>">Recommended Next Action</span>
        <% if (nextAction.canAct) { %>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#0284C7] text-white">Action Ready For Your Role</span>
        <% } %>
      </div>
      <h3 class="text-sm font-bold text-[#1A2A42]"><%= nextAction.title %></h3>
      <p class="text-xs text-slate-600"><%= nextAction.description %></p>
    </div>

    <% if (nextAction.actionLabel && nextAction.actionUrl) { %>
      <div class="flex-shrink-0">
        <a href="<%= nextAction.actionUrl %>"
           class="px-5 py-2.5 <%= nextAction.canAct ? 'bg-[#207E85] hover:bg-[#19656b] text-white' : 'bg-white hover:bg-slate-50 text-slate-700 border border-[#E7EDEF]' %> text-xs font-bold rounded-lg shadow-sm transition inline-flex items-center gap-1.5">
          <span><%= nextAction.actionLabel %></span>
          <span>→</span>
        </a>
      </div>
    <% } %>
  </div>
  <% } %>

  <!-- 3. Lifecycle Progress Stepper (12 Canonical Stages) -->
  <%
    const stages = [
      { key: 'SUBMITTED', label: '1. Proposal' },
      { key: 'AI_PROCESSED', label: '2. AI Extraction' },
      { key: 'VERIFIED', label: '3. Verification' },
      { key: 'DISTRICT_APPROVAL', label: '4. District (L1)' },
      { key: 'STATE_APPROVAL', label: '5. State (L2)' },
      { key: 'CENTRAL_APPROVAL', label: '6. Central (L3)' },
      { key: 'NOTIFICATION_ISSUED', label: '7. Gazette' },
      { key: 'AWARD_DECLARED', label: '8. Award' },
      { key: 'COMPENSATION_PAID', label: '9. Payout' },
      { key: 'POSSESSION_COMPLETED', label: '10. Possession' },
      { key: 'RR_IN_PROGRESS', label: '11. R&R' },
      { key: 'CLOSED', label: '12. Closed' },
    ];

    const currentStatus = record.acquisitionStatus || record.status || 'DRAFT';
    const stageOrder = [
      'DRAFT', 'SUBMITTED', 'AI_PROCESSING', 'AI_PROCESSED', 'PENDING_VERIFICATION',
      'VERIFICATION_INCOMPLETE', 'VERIFIED', 'DISTRICT_APPROVAL', 'PENDING_APPROVAL',
      'STATE_APPROVAL', 'CENTRAL_APPROVAL', 'APPROVED', 'NOTIFICATION_ISSUED',
      'AWARD_DECLARED', 'COMPENSATION_PENDING', 'COMPENSATION_APPROVED', 'COMPENSATION_PAID',
      'POSSESSION_PENDING', 'POSSESSION_COMPLETED', 'RR_IN_PROGRESS', 'RR_COMPLETED', 'CLOSED'
    ];
    const currentIndex = stageOrder.indexOf(currentStatus);

    function isStageDone(key) {
      if (key === 'SUBMITTED') return currentIndex >= 1;
      if (key === 'AI_PROCESSED') return currentIndex >= 3;
      if (key === 'VERIFIED') return currentIndex >= 6;
      if (key === 'DISTRICT_APPROVAL') return currentIndex >= 7;
      if (key === 'STATE_APPROVAL') return currentIndex >= 9;
      if (key === 'CENTRAL_APPROVAL') return currentIndex >= 11;
      if (key === 'NOTIFICATION_ISSUED') return currentIndex >= 12;
      if (key === 'AWARD_DECLARED') return currentIndex >= 13;
      if (key === 'COMPENSATION_PAID') return currentIndex >= 16;
      if (key === 'POSSESSION_COMPLETED') return currentIndex >= 18;
      if (key === 'RR_IN_PROGRESS') return currentIndex >= 19;
      if (key === 'CLOSED') return currentIndex >= 21;
      return false;
    }
  %>

  <div class="bg-white p-5 rounded-xl border border-[#E7EDEF] shadow-sm space-y-3">
    <div class="flex items-center justify-between pb-2 border-b border-[#E7EDEF]">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500">12-Stage National Acquisition Lifecycle</h2>
      <span class="text-xs font-semibold font-mono text-[#207E85]">Active Milestone: <%= (record.acquisitionStatus || 'SUBMITTED').replace(/_/g, ' ') %></span>
    </div>

    <div class="overflow-x-auto pb-2">
      <div class="flex items-center justify-between min-w-[920px] pt-2">
        <% stages.forEach((st, idx) => {
          const done = isStageDone(st.key);
          const isCurrent = record.acquisitionStatus === st.key;
        %>
          <div class="flex-1 text-center relative <%= idx !== stages.length - 1 ? 'after:content-[\'\'] after:absolute after:top-3 after:left-1/2 after:w-full after:h-0.5 ' + (done ? 'after:bg-[#207E85]' : 'after:bg-[#E7EDEF]') : '' %>">
            <div class="w-6 h-6 mx-auto rounded-full flex items-center justify-center text-[10px] font-bold relative z-10 <%= done ? 'bg-[#207E85] text-white' : isCurrent ? 'bg-[#207E85] text-white ring-4 ring-[#E8F3F4]' : 'bg-[#F3F8F9] text-slate-400 border border-[#E7EDEF]' %>">
              <% if (done) { %>✓<% } else { %><%= idx + 1 %><% } %>
            </div>
            <div class="mt-2 text-[10px] leading-tight font-medium <%= done ? 'text-[#207E85] font-semibold' : isCurrent ? 'text-[#1A2A42] font-bold' : 'text-slate-400' %>">
              <%= st.label %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- 4. Prototype Decision Support & Risk Engine Banner -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Risk Assessment Card -->
    <div class="bg-white p-5 rounded-xl border border-[#E7EDEF] shadow-sm space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-[#1A2A42] flex items-center gap-1.5">
          <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          Decision Support Delay & Bottleneck Engine
        </span>
        <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= riskAssessment.riskLevel === 'HIGH' ? 'bg-rose-100 text-rose-800' : riskAssessment.riskLevel === 'MEDIUM' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800' %>">
          Risk: <%= riskAssessment.riskLevel %> (<%= riskAssessment.riskScore %>/100)
        </span>
      </div>
      <p class="text-xs text-slate-600 font-medium">Suggested Action: <%= riskAssessment.suggestedAction %></p>
      <div class="text-[11px] text-slate-500">
        <% riskAssessment.reasons.forEach(r => { %>
          <div>• <%= r %></div>
        <% }); %>
      </div>
      <div class="text-[10px] text-slate-400 italic pt-1">
        Transparent rule-based heuristic scoring (Prototype Mode for SIH evaluation).
      </div>
    </div>

    <!-- AI Scrutiny Status Card -->
    <div class="bg-white p-5 rounded-xl border border-[#E7EDEF] shadow-sm space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-[#1A2A42] flex items-center gap-1.5">
          <svg class="w-4 h-4 text-[#207E85]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          Multi-Lingual OCR & AI Scrutiny (Prototype Mode)
        </span>
        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#E8F3F4] text-[#207E85]">
          Marathi → English
        </span>
      </div>
      <div class="text-xs text-slate-600">
        Source document parsed. AI identified survey number anomaly: OCR scanned <strong class="text-rose-700 font-mono">142/3</strong> at 61% confidence; suggested ground truth <strong class="text-emerald-700 font-mono">142/8</strong> based on revenue index.
      </div>
      <div class="flex items-center justify-between pt-1 text-[11px]">
        <span class="text-slate-400">Cryptographic Anchor: <%= (record.landRecordHash || record.requestId).slice(0, 16) %>...</span>
        <a href="#documents-section" class="text-[#207E85] font-semibold hover:underline">Inspect AI Fields ↓</a>
      </div>
    </div>
  </div>

  <!-- 5. Navigation Tab Pills -->
  <div class="bg-white p-2 rounded-xl border border-[#E7EDEF] shadow-sm flex items-center gap-1.5 overflow-x-auto text-xs font-semibold">
    <button type="button" onclick="showTab('overview')" id="tabBtn_overview" class="px-3.5 py-2 rounded-lg bg-[#207E85] text-white transition">Overview & Cadastral</button>
    <button type="button" onclick="showTab('documents')" id="tabBtn_documents" class="px-3.5 py-2 rounded-lg text-slate-600 hover:bg-slate-100 transition">Documents & AI</button>
    <button type="button" onclick="showTab('approvals')" id="tabBtn_approvals" class="px-3.5 py-2 rounded-lg text-slate-600 hover:bg-slate-100 transition">3-Tier Approvals</button>
    <button type="button" onclick="showTab('statutory')" id="tabBtn_statutory" class="px-3.5 py-2 rounded-lg text-slate-600 hover:bg-slate-100 transition">Gazette & Award</button>
    <button type="button" onclick="showTab('compensation')" id="tabBtn_compensation" class="px-3.5 py-2 rounded-lg text-slate-600 hover:bg-slate-100 transition">Compensation & DBT</button>
    <button type="button" onclick="showTab('possession')" id="tabBtn_possession" class="px-3.5 py-2 rounded-lg text-slate-600 hover:bg-slate-100 transition">Possession & Panchnama</button>
    <button type="button" onclick="showTab('rnr')" id="tabBtn_rnr" class="px-3.5 py-2 rounded-lg text-slate-600 hover:bg-slate-100 transition">R&R & Closure</button>
    <button type="button" onclick="showTab('audit')" id="tabBtn_audit" class="px-3.5 py-2 rounded-lg text-slate-600 hover:bg-slate-100 transition">Audit Trail</button>
  </div>

  <!-- ========================================================================= -->
  <!-- TAB 1: Overview & Cadastral Specs -->
  <!-- ========================================================================= -->
  <div id="tabContent_overview" class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 items-start">
      <!-- Land Parcel Specs -->
      <div class="bg-white p-5 rounded-xl border border-[#E7EDEF] shadow-sm space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 pb-2 border-b border-[#E7EDEF]">
          Land Parcel Specifications
        </h2>
        <div class="space-y-2 text-xs">
          <div class="flex justify-between py-1.5 border-b border-slate-50">
            <span class="text-slate-400">Survey / Hissa:</span>
            <span class="font-mono font-bold text-[#1A2A42]"><%= record.surveyNumber || '142/8' %> / <%= record.subDivision || 'A' %></span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-slate-50">
            <span class="text-slate-400">Khata Number:</span>
            <span class="font-mono font-bold text-[#1A2A42]"><%= record.khataNumber || 'KH-8821' %></span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-slate-50">
            <span class="text-slate-400">Total Acquired Area:</span>
            <span class="font-bold text-[#1A2A42]"><%= record.area?.total || 45.2 %> <%= record.area?.unit || 'Ha' %></span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-slate-50">
            <span class="text-slate-400">Land Classification:</span>
            <span class="text-slate-700 font-medium"><%= record.landType || 'Agricultural (Jirayat)' %></span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-slate-50">
            <span class="text-slate-400">Centroid Coordinates:</span>
            <span class="font-mono text-[#207E85] font-semibold"><%= record.location?.latitude || '19.8512' %>°N, <%= record.location?.longitude || '73.9921' %>°E</span>
          </div>
          <div class="flex justify-between py-1.5">
            <span class="text-slate-400">Acquisition Purpose:</span>
            <span class="text-slate-700 font-medium text-right"><%= record.acquisitionPurpose || 'Greenfield Highway Expansion' %></span>
          </div>
        </div>
      </div>

      <!-- Ownership & Beneficiary Details -->
      <div class="bg-white p-5 rounded-xl border border-[#E7EDEF] shadow-sm space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 pb-2 border-b border-[#E7EDEF]">
          Registered Land Owner & Awardee
        </h2>
        <% 
          const ownerList = (record.owners && record.owners.length > 0) 
            ? record.owners 
            : [{ name: record.landOwner || 'Ramesh Patil', fatherName: 'Tukaram Patil', share: '1/1', contactNumber: '9822012345' }];
        %>
        <div class="space-y-3 text-xs">
          <% ownerList.forEach((o, i) => { %>
            <div class="p-4 rounded-xl bg-[#F8FAFB] border border-[#E7EDEF] flex items-center justify-between">
              <div>
                <div class="font-bold text-sm text-[#1A2A42]"><%= o.name %></div>
                <div class="text-[11px] text-slate-400 mt-0.5">Father / Relative: <%= o.fatherName || 'Tukaram Patil' %></div>
                <div class="text-[11px] text-slate-500 mt-1">Contact: <span class="font-mono"><%= o.contactNumber || '9822012345' %></span></div>
              </div>
              <div class="text-right">
                <span class="px-2 py-1 rounded bg-[#E8F3F4] text-[#207E85] font-mono font-bold text-xs">Share: <%= o.share || '100%' %></span>
                <div class="text-[10px] text-emerald-700 font-semibold mt-1">✓ Title Confirmed</div>
              </div>
            </div>
          <% }); %>
        </div>

        <div class="pt-2 text-xs text-slate-500 border-t border-[#E7EDEF] flex items-center justify-between">
          <span>Affected Families: <strong><%= record.affectedFamilies || 1 %></strong></span>
          <span>Displaced Families: <strong><%= record.displacedFamilies || 0 %></strong></span>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- TAB 2: Documents & AI Scrutiny -->
  <!-- ========================================================================= -->
  <div id="tabContent_documents" class="hidden space-y-6">
    <div class="bg-white p-5 rounded-xl border border-[#E7EDEF] shadow-sm space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-[#E7EDEF]">
        <div>
          <h2 class="text-sm font-bold text-[#1A2A42]">Attached Source Documents</h2>
          <p class="text-[11px] text-slate-400">Authenticated streaming enabled. Static uploads blocked for security.</p>
        </div>
        <a href="/verification/<%= record.requestId %>" class="px-3 py-1.5 bg-[#207E85] hover:bg-[#19656b] text-white text-xs font-semibold rounded-lg shadow-sm">
          Open Data Checker Workbench →
        </a>
      </div>

      <% if (documents && documents.length > 0) { %>
        <div class="space-y-3">
          <% documents.forEach((doc) => { %>
            <div class="p-4 rounded-xl border border-[#E7EDEF] bg-[#F8FAFB] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
              <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-lg bg-[#E8F3F4] text-[#207E85] flex items-center justify-center font-bold text-xs font-mono">
                  PDF
                </span>
                <div>
                  <div class="font-bold text-[#1A2A42] text-sm"><%= (doc.documentType || '7/12 Extract').replace(/_/g, ' ') %></div>
                  <div class="text-[11px] text-slate-400 font-mono"><%= doc.originalName || doc.fileName || '7-12-extract-142-8.pdf' %></div>
                  <div class="text-[10px] text-slate-400 font-mono mt-0.5">SHA-256: <%= (doc.fileHash || doc.hash || 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855').slice(0, 24) %>...</div>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <a href="/api/documents/<%= doc.documentId %>/file" target="_blank"
                   class="px-3.5 py-2 bg-white hover:bg-slate-50 border border-[#E7EDEF] text-[#207E85] text-xs font-bold rounded-lg shadow-sm transition">
                  Stream Document File ↗
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="p-4 rounded-xl border border-[#E7EDEF] bg-[#F8FAFB] flex items-center justify-between text-xs">
          <div>
            <div class="font-bold text-[#1A2A42]">7/12 Satbara Extract (Demo Document)</div>
            <div class="text-[11px] text-slate-400 font-mono">7_12_Extract_Nashik_Sinnar_142_8.pdf</div>
          </div>
          <a href="/verification/<%= record.requestId %>" class="px-3 py-1.5 bg-[#207E85] text-white text-xs font-semibold rounded-lg">
            Inspect in Workbench
          </a>
        </div>
      <% } %>

      <!-- AI Scrutiny Field Comparison Table -->
      <div class="pt-4 border-t border-[#E7EDEF] space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-600">AI Extraction Cross-Examination</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs data-table">
            <thead>
              <tr>
                <th>Field Attribute</th>
                <th>Raw OCR Scanned</th>
                <th>AI Confidence</th>
                <th>Human Verified / Ground Truth</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr class="bg-rose-50/40">
                <td class="font-bold text-[#1A2A42]">Survey Number</td>
                <td class="font-mono text-rose-700 font-bold">142/3</td>
                <td>
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">61% (Low)</span>
                </td>
                <td class="font-mono font-bold text-emerald-700">142/8</td>
                <td class="text-xs font-semibold text-emerald-700">✓ Corrected & Verified</td>
              </tr>
              <tr>
                <td class="font-bold text-[#1A2A42]">Owner Name</td>
                <td>रमेश तुकाराम पाटील</td>
                <td><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">96%</span></td>
                <td class="font-medium text-[#1A2A42]">Ramesh Patil</td>
                <td class="text-xs font-semibold text-emerald-700">✓ Translated</td>
              </tr>
              <tr>
                <td class="font-bold text-[#1A2A42]">Acquired Area</td>
                <td class="font-mono">45.2 हेक्टर</td>
                <td><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">94%</span></td>
                <td class="font-mono font-bold text-[#1A2A42]">45.2 Ha</td>
                <td class="text-xs font-semibold text-emerald-700">✓ Matches Proposal</td>
              </tr>
              <tr>
                <td class="font-bold text-[#1A2A42]">Village / Tehsil</td>
                <td>सिन्नर, जि. नाशिक</td>
                <td><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">98%</span></td>
                <td class="font-medium text-[#1A2A42]">Sinnar, Nashik</td>
                <td class="text-xs font-semibold text-emerald-700">✓ Validated</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- TAB 3: Multi-Tier Approvals (Level 1, 2, 3) -->
  <!-- ========================================================================= -->
  <div id="tabContent_approvals" class="hidden space-y-6">
    <div class="bg-white p-6 rounded-xl border border-[#E7EDEF] shadow-sm space-y-5">
      <div class="border-b border-[#E7EDEF] pb-3">
        <h2 class="text-sm font-bold text-[#1A2A42]">3-Tier Statutory Approval Authority Chain</h2>
        <p class="text-[11px] text-slate-400">Strict RBAC routing: District Authority (L1) → State Authority (L2) → Central Authority (L3).</p>
      </div>

      <!-- Level 1: District Authority -->
      <div class="p-4 rounded-xl border border-[#E7EDEF] bg-[#F8FAFB] space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-[#207E85] text-white flex items-center justify-center font-bold text-xs">1</span>
            <div>
              <div class="font-bold text-xs text-[#1A2A42]">Level 1: District Authority (Collectorate)</div>
              <div class="text-[11px] text-slate-400">Verification scrutiny, boundary reconciliation & gazette recommendation</div>
            </div>
          </div>
          <div>
            <% const l1 = (approvals || []).find(a => a.approvalLevel === 1 || a.authority === 'DISTRICT_AUTHORITY'); %>
            <% if (l1 && (l1.action === 'APPROVED' || l1.action === 'FORWARDED' || l1.status === 'APPROVED' || l1.status === 'FORWARDED')) { %>
              <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">✓ Endorsed & Forwarded</span>
            <% } else { %>
              <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800">Pending Review</span>
            <% } %>
          </div>
        </div>

        <% if (['DISTRICT_AUTHORITY', 'SUPER_ADMIN'].includes(currentUser.role) && record.acquisitionStatus === 'DISTRICT_APPROVAL') { %>
          <form method="POST" action="/land/<%= record.requestId %>/approval-action" class="pt-2 border-t border-[#E7EDEF] space-y-3">
            <input type="hidden" name="approvalId" value="<%= l1 ? l1._id : '' %>" />
            <div class="text-xs font-semibold text-slate-700">District Authority Action:</div>
            <textarea name="remarks" rows="2" class="w-full p-2.5 rounded-lg border border-[#E7EDEF] text-xs" placeholder="Enter Collectorate verification remarks...">Verified survey 142/8 boundaries, title deed, and village map. Recommended for State gazette approval.</textarea>
            <div class="flex gap-2">
              <button type="submit" name="action" value="forward" class="px-4 py-2 bg-[#207E85] hover:bg-[#19656b] text-white text-xs font-bold rounded-lg shadow-sm">
                Endorse & Forward to State Authority (L2) →
              </button>
              <button type="submit" name="action" value="reject" class="px-3.5 py-2 bg-rose-50 text-rose-700 border border-rose-200 text-xs font-semibold rounded-lg hover:bg-rose-100">
                Return with Objections
              </button>
            </div>
          </form>
        <% } %>
      </div>

      <!-- Level 2: State Authority -->
      <div class="p-4 rounded-xl border border-[#E7EDEF] bg-[#F8FAFB] space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-[#207E85] text-white flex items-center justify-center font-bold text-xs">2</span>
            <div>
              <div class="font-bold text-xs text-[#1A2A42]">Level 2: State Authority (Revenue & Forest Dept)</div>
              <div class="text-[11px] text-slate-400">Inter-district alignment review & State executive clearance</div>
            </div>
          </div>
          <div>
            <% const l2 = (approvals || []).find(a => a.approvalLevel === 2 || a.authority === 'STATE_AUTHORITY'); %>
            <% if (l2 && (l2.action === 'APPROVED' || l2.action === 'FORWARDED' || l2.status === 'APPROVED' || l2.status === 'FORWARDED')) { %>
              <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">✓ State Cleared</span>
            <% } else if (record.acquisitionStatus === 'STATE_APPROVAL') { %>
              <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800">Pending State Endorsement</span>
            <% } else { %>
              <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-500">Awaiting Level 1</span>
            <% } %>
          </div>
        </div>

        <% if (['STATE_AUTHORITY', 'SUPER_ADMIN'].includes(currentUser.role) && record.acquisitionStatus === 'STATE_APPROVAL') { %>
          <form method="POST" action="/land/<%= record.requestId %>/approval-action" class="pt-2 border-t border-[#E7EDEF] space-y-3">
            <input type="hidden" name="approvalId" value="<%= l2 ? l2._id : '' %>" />
            <div class="text-xs font-semibold text-slate-700">State Authority Action:</div>
            <textarea name="remarks" rows="2" class="w-full p-2.5 rounded-lg border border-[#E7EDEF] text-xs" placeholder="Enter State Revenue Department remarks...">State alignment cleared. Forwarded to Central Ministry for national highway sanction.</textarea>
            <div class="flex gap-2">
              <button type="submit" name="action" value="forward" class="px-4 py-2 bg-[#207E85] hover:bg-[#19656b] text-white text-xs font-bold rounded-lg shadow-sm">
                Endorse & Forward to Central Ministry (L3) →
              </button>
              <button type="submit" name="action" value="reject" class="px-3.5 py-2 bg-rose-50 text-rose-700 border border-rose-200 text-xs font-semibold rounded-lg hover:bg-rose-100">
                Reject / Return
              </button>
            </div>
          </form>
        <% } %>
      </div>

      <!-- Level 3: Central Authority -->
      <div class="p-4 rounded-xl border border-[#E7EDEF] bg-[#F8FAFB] space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-[#207E85] text-white flex items-center justify-center font-bold text-xs">3</span>
            <div>
              <div class="font-bold text-xs text-[#1A2A42]">Level 3: Central Authority (Ministry)</div>
              <div class="text-[11px] text-slate-400">Final administrative approval, national budget allocation & statutory sanction</div>
            </div>
          </div>
          <div>
            <% const l3 = (approvals || []).find(a => a.approvalLevel === 3 || a.authority === 'CENTRAL_AUTHORITY'); %>
            <% if (l3 && (l3.action === 'APPROVED' || l3.status === 'APPROVED') || ['APPROVED', 'NOTIFICATION_ISSUED', 'AWARD_DECLARED', 'COMPENSATION_PAID', 'POSSESSION_COMPLETED', 'CLOSED'].includes(record.acquisitionStatus)) { %>
              <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">✓ Final Central Sanction Granted</span>
            <% } else if (record.acquisitionStatus === 'CENTRAL_APPROVAL') { %>
              <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800">Pending Central Sanction</span>
            <% } else { %>
              <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-500">Awaiting Level 2</span>
            <% } %>
          </div>
        </div>

        <% if (['CENTRAL_AUTHORITY', 'SUPER_ADMIN'].includes(currentUser.role) && record.acquisitionStatus === 'CENTRAL_APPROVAL') { %>
          <form method="POST" action="/land/<%= record.requestId %>/approval-action" class="pt-2 border-t border-[#E7EDEF] space-y-3">
            <input type="hidden" name="approvalId" value="<%= l3 ? l3._id : '' %>" />
            <div class="text-xs font-semibold text-slate-700">Central Ministry Action:</div>
            <textarea name="remarks" rows="2" class="w-full p-2.5 rounded-lg border border-[#E7EDEF] text-xs" placeholder="Enter Central sanction remarks...">Final central administrative approval granted under National Land Acquisition Guidelines 2026. Proceed with Section 11 gazette notification.</textarea>
            <div class="flex gap-2">
              <button type="submit" name="action" value="approve" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-lg shadow-md transition">
                Grant Final Central Sanction (Approve) ✓
              </button>
              <button type="submit" name="action" value="reject" class="px-3.5 py-2 bg-rose-50 text-rose-700 border border-rose-200 text-xs font-semibold rounded-lg hover:bg-rose-100">
                Reject Proposal
              </button>
            </div>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- TAB 4: Statutory Gazette & Award Declaration -->
  <!-- ========================================================================= -->
  <div id="tabContent_statutory" class="hidden space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <!-- Section 11 Preliminary Notification -->
      <div class="bg-white p-5 rounded-xl border border-[#E7EDEF] shadow-sm space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-[#E7EDEF]">
          <div>
            <h2 class="text-sm font-bold text-[#1A2A42]">Gazette Notification (Sec 4/11)</h2>
            <p class="text-[11px] text-slate-400">Statutory public notice of proposed acquisition.</p>
          </div>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= record.notificationStatus === 'ISSUED' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
            <%= record.notificationStatus || 'PENDING' %>
          </span>
        </div>

        <div class="space-y-2 text-xs">
          <div class="flex justify-between py-1 border-b border-slate-50">
            <span class="text-slate-400">Notification No:</span>
            <span class="font-mono font-bold text-[#1A2A42]"><%= record.notificationNumber || 'NOTIF/2026/LA-0003' %></span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-50">
            <span class="text-slate-400">Gazette Publication Date:</span>
            <span class="text-slate-700 font-medium"><%= record.notificationDate ? new Date(record.notificationDate).toLocaleDateString('en-IN') : '14/02/2026' %></span>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-slate-400">Statutory Type:</span>
            <span class="text-slate-700 font-medium"><%= record.notificationType || 'SECTION_11' %></span>
          </div>
        </div>

        <% if (['DISTRICT_AUTHORITY', 'STATE_AUTHORITY', 'SUPER_ADMIN'].includes(currentUser.role) && ['APPROVED', 'CENTRAL_APPROVAL'].includes(record.acquisitionStatus)) { %>
          <form method="POST" action="/land/<%= record.requestId %>/notification" class="pt-3 border-t border-[#E7EDEF] space-y-3 text-xs">
            <div class="font-bold text-[#1A2A42]">Issue Official Gazette Notification:</div>
            <div>
              <label class="block text-slate-500 mb-1">Gazette Notification Number</label>
              <input type="text" name="notificationNumber" value="NOTIF/2026/LA-0003" class="w-full p-2 border border-[#E7EDEF] rounded font-mono" required />
            </div>
            <div>
              <label class="block text-slate-500 mb-1">Notification Date</label>
              <input type="date" name="notificationDate" value="2026-02-14" class="w-full p-2 border border-[#E7EDEF] rounded" required />
            </div>
            <button type="submit" class="w-full py-2 bg-[#207E85] text-white font-bold rounded-lg hover:bg-[#19656b] transition">
              Publish Section 11 Notification →
            </button>
          </form>
        <% } %>
      </div>

      <!-- Section 23 Final Award Declaration -->
      <div class="bg-white p-5 rounded-xl border border-[#E7EDEF] shadow-sm space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-[#E7EDEF]">
          <div>
            <h2 class="text-sm font-bold text-[#1A2A42]">Land Award Declaration (Sec 23)</h2>
            <p class="text-[11px] text-slate-400">Determines definitive market value & solatium.</p>
          </div>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= record.awardStatus === 'DECLARED' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
            <%= record.awardStatus || 'PENDING' %>
          </span>
        </div>

        <div class="space-y-2 text-xs">
          <div class="flex justify-between py-1 border-b border-slate-50">
            <span class="text-slate-400">Award Number:</span>
            <span class="font-mono font-bold text-[#1A2A42]"><%= record.awardNumber || 'AWD/NSK/2026-442' %></span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-50">
            <span class="text-slate-400">Declaration Date:</span>
            <span class="text-slate-700 font-medium"><%= record.awardDate ? new Date(record.awardDate).toLocaleDateString('en-IN') : '28/02/2026' %></span>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-slate-400">Total Award Sanction:</span>
            <span class="font-mono font-bold text-emerald-700 text-sm">₹<%= (record.awardAmount || 28500000).toLocaleString('en-IN') %></span>
          </div>
        </div>

        <% if (['DISTRICT_AUTHORITY', 'FINANCE_OFFICER', 'SUPER_ADMIN'].includes(currentUser.role) && record.acquisitionStatus === 'NOTIFICATION_ISSUED') { %>
          <form method="POST" action="/land/<%= record.requestId %>/award" class="pt-3 border-t border-[#E7EDEF] space-y-3 text-xs">
            <div class="font-bold text-[#1A2A42]">Pass Section 23 Acquisition Award:</div>
            <div>
              <label class="block text-slate-500 mb-1">Award Number</label>
              <input type="text" name="awardNumber" value="AWD/NSK/2026-442" class="w-full p-2 border border-[#E7EDEF] rounded font-mono" required />
            </div>
            <div>
              <label class="block text-slate-500 mb-1">Award Amount (INR)</label>
              <input type="number" name="awardAmount" value="28500000" class="w-full p-2 border border-[#E7EDEF] rounded font-mono font-bold" required />
            </div>
            <button type="submit" class="w-full py-2 bg-emerald-600 text-white font-bold rounded-lg hover:bg-emerald-700 transition">
              Declare Official Land Award →
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- TAB 5: Compensation & Direct Benefit Transfer -->
  <!-- ========================================================================= -->
  <div id="tabContent_compensation" class="hidden space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Valuation Details -->
      <div class="lg:col-span-2 bg-white p-5 rounded-xl border border-[#E7EDEF] shadow-sm space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-[#E7EDEF]">
          <div>
            <h2 class="text-sm font-bold text-[#1A2A42]">RFCTLARR 2013 Valuation Matrix</h2>
            <p class="text-[11px] text-slate-400">Formula: Market Value + 100% Solatium (Sec 30) + Additional Assets.</p>
          </div>
          <span class="px-2.5 py-1 rounded-full text-xs font-bold <%= (compensation && compensation.paymentStatus === 'PAID') ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
            <%= (compensation && compensation.paymentStatus) || 'PENDING_PAYMENT' %>
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
          <div class="p-3 rounded-lg bg-[#F8FAFB] border border-[#E7EDEF]">
            <span class="text-slate-400">Base Land Value:</span>
            <p class="font-mono font-bold text-[#1A2A42] text-sm mt-1">₹1,42,50,000</p>
            <span class="text-[10px] text-slate-400">Nashik Sub-Registrar circle rate</span>
          </div>
          <div class="p-3 rounded-lg bg-[#F8FAFB] border border-[#E7EDEF]">
            <span class="text-slate-400">Solatium (100%):</span>
            <p class="font-mono font-bold text-[#207E85] text-sm mt-1">₹1,42,50,000</p>
            <span class="text-[10px] text-slate-400">Mandatory statutory entitlement</span>
          </div>
          <div class="p-3 rounded-lg bg-emerald-50 border border-emerald-200">
            <span class="text-emerald-700 font-bold">Total Approved Award:</span>
            <p class="font-mono font-extrabold text-emerald-800 text-base mt-1">₹<%= ((compensation && (compensation.approvedAmount || compensation.assessedAmount)) || 28500000).toLocaleString('en-IN') %></p>
            <span class="text-[10px] text-emerald-600 font-medium">Beneficiary: Ramesh Patil</span>
          </div>
        </div>

        <!-- Sandbox Direct Disbursement Payout -->
        <% if (compensation && compensation.paymentStatus === 'PAID') { %>
          <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 space-y-2 text-xs">
            <div class="flex items-center gap-2 text-emerald-900 font-bold">
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <span>Compensation Payout Disbursed & Confirmed</span>
            </div>
            <div class="font-mono text-[11px] text-emerald-800 break-all">
              Blockchain Transaction Anchor: <%= compensation.blockchainTxHash || '0x7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1fa3d677284addd200126d9069' %>
            </div>
            <div class="text-[11px] text-emerald-700">
              Disbursed via PFMS/DBT Sandbox on: <%= compensation.paidAt ? new Date(compensation.paidAt).toLocaleString('en-IN') : 'Confirmed' %>
            </div>
          </div>
        <% } else if (['FINANCE_OFFICER', 'CENTRAL_AUTHORITY', 'SUPER_ADMIN'].includes(currentUser.role)) { %>
          <form method="POST" action="/land/<%= record.requestId %>/disburse" class="p-4 rounded-xl bg-[#F0FDF4] border border-emerald-200 space-y-3">
            <div class="text-xs font-bold text-emerald-900">Execute Instant Benefit Transfer (Sandbox DBT/PFMS):</div>
            <p class="text-[11px] text-emerald-700 leading-relaxed">
              Triggers simulated instant RTGS/PFMS release of ₹2.85 Crore directly into Ramesh Patil's verified Aadhaar-linked account, anchoring transaction hash to the immutable ledger.
            </p>
            <button type="submit" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-lg shadow-md transition flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
              <span>Disburse Payout to Beneficiary (₹2.85 Cr) →</span>
            </button>
          </form>
        <% } %>
      </div>

      <!-- Bank & Account Card -->
      <div class="bg-white p-5 rounded-xl border border-[#E7EDEF] shadow-sm space-y-3 text-xs">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 pb-2 border-b border-[#E7EDEF]">Beneficiary Account Scrutiny</h2>
        <div class="space-y-2">
          <div>
            <span class="text-slate-400">Account Holder:</span>
            <p class="font-bold text-[#1A2A42] mt-0.5">Ramesh Tukaram Patil</p>
          </div>
          <div>
            <span class="text-slate-400">Bank & Branch:</span>
            <p class="font-medium text-slate-700 mt-0.5">State Bank of India · Sinnar Branch</p>
          </div>
          <div>
            <span class="text-slate-400">IFSC Code:</span>
            <p class="font-mono text-slate-700 mt-0.5">SBIN0000421</p>
          </div>
          <div>
            <span class="text-slate-400">PFMS Aadhaar Validation:</span>
            <p class="text-emerald-700 font-bold mt-0.5">✓ Seeding Verified & Active</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- TAB 6: Physical Possession & Panchnama -->
  <!-- ========================================================================= -->
  <div id="tabContent_possession" class="hidden space-y-6">
    <div class="bg-white p-6 rounded-xl border border-[#E7EDEF] shadow-sm space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-[#E7EDEF]">
        <div>
          <h2 class="text-sm font-bold text-[#1A2A42]">Physical Land Possession & Site Demarcation</h2>
          <p class="text-[11px] text-slate-400">Panchnama execution, site demarcation stones, and handover certificate.</p>
        </div>
        <span class="px-2.5 py-1 rounded-full text-xs font-bold <%= record.possessionStatus === 'COMPLETED' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
          <%= record.possessionStatus || 'PENDING' %>
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div class="p-3 rounded-lg bg-[#F8FAFB] border border-[#E7EDEF]">
          <span class="text-slate-400">Possession Officer:</span>
          <p class="font-bold text-[#1A2A42] mt-1"><%= record.possessionOfficer || 'Tehsildar & Executive Engineer' %></p>
        </div>
        <div class="p-3 rounded-lg bg-[#F8FAFB] border border-[#E7EDEF]">
          <span class="text-slate-400">Execution Date:</span>
          <p class="font-medium text-slate-700 mt-1"><%= record.possessionDate ? new Date(record.possessionDate).toLocaleDateString('en-IN') : 'Pending Site Visit' %></p>
        </div>
        <div class="p-3 rounded-lg bg-[#F8FAFB] border border-[#E7EDEF]">
          <span class="text-slate-400">Field Survey App Sync:</span>
          <a href="/land/<%= record.requestId %>/field-mode" class="text-[#207E85] font-bold block mt-1 hover:underline">
            Launch Mobile Field Mode ↗
          </a>
        </div>
      </div>

      <div class="p-3 rounded-lg bg-[#F8FAFB] border border-[#E7EDEF] text-xs">
        <span class="text-slate-400">Panchnama Observations:</span>
        <p class="text-slate-700 mt-1 font-medium"><%= record.possessionRemarks || 'Physical boundary stones installed. Panchnama recorded in presence of Talathi and witnesses. Parcel handed over to National Highways Authority.' %></p>
      </div>

      <% if (['DISTRICT_AUTHORITY', 'PROJECT_OFFICER', 'SUPER_ADMIN'].includes(currentUser.role) && record.possessionStatus !== 'COMPLETED') { %>
        <form method="POST" action="/land/<%= record.requestId %>/possession" class="pt-3 border-t border-[#E7EDEF] space-y-3 text-xs">
          <div class="font-bold text-[#1A2A42]">Execute & Record Possession Handover:</div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-slate-500 mb-1">Executing Officer Name</label>
              <input type="text" name="officerName" value="K. V. Deshmukh, Tehsildar Sinnar" class="w-full p-2 border border-[#E7EDEF] rounded" required />
            </div>
            <div>
              <label class="block text-slate-500 mb-1">Handover Date</label>
              <input type="date" name="possessionDate" value="2026-03-05" class="w-full p-2 border border-[#E7EDEF] rounded" required />
            </div>
          </div>
          <div>
            <label class="block text-slate-500 mb-1">Panchnama & Demarcation Remarks</label>
            <textarea name="remarks" rows="2" class="w-full p-2.5 rounded border border-[#E7EDEF]">Physical possession taken. 4 boundary pillars cemented. Panchnama signed by landowner Ramesh Patil and village Talathi.</textarea>
          </div>
          <input type="hidden" name="possessionStatus" value="COMPLETED" />
          <button type="submit" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg shadow-sm transition">
            Confirm Possession & Sign Panchnama ✓
          </button>
        </form>
      <% } %>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- TAB 7: R&R (Rehabilitation & Resettlement) & Closure -->
  <!-- ========================================================================= -->
  <div id="tabContent_rnr" class="hidden space-y-6">
    <div class="bg-white p-6 rounded-xl border border-[#E7EDEF] shadow-sm space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-[#E7EDEF]">
        <div>
          <h2 class="text-sm font-bold text-[#1A2A42]">Rehabilitation & Resettlement (R&R) Scrutiny</h2>
          <p class="text-[11px] text-slate-400">Socio-economic rehabilitation under Second Schedule RFCTLARR 2013.</p>
        </div>
        <span class="px-2.5 py-1 rounded-full text-xs font-bold <%= record.acquisitionStatus === 'CLOSED' ? 'bg-emerald-100 text-emerald-800' : 'bg-[#E8F3F4] text-[#207E85]' %>">
          <%= record.acquisitionStatus === 'CLOSED' ? 'CASE CLOSED & ARCHIVED' : (record.rrStatus || 'IN_PROGRESS') %>
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div class="p-3 rounded-lg bg-[#F8FAFB] border border-[#E7EDEF]">
          <span class="text-slate-400">Rehabilitation Status:</span>
          <p class="font-bold text-[#1A2A42] mt-1"><%= record.rehabilitationStatus || 'Livelihood Grant Settled' %></p>
        </div>
        <div class="p-3 rounded-lg bg-[#F8FAFB] border border-[#E7EDEF]">
          <span class="text-slate-400">Resettlement Status:</span>
          <p class="font-bold text-[#1A2A42] mt-1"><%= record.resettlementStatus || 'No Physical Displacement' %></p>
        </div>
        <div class="p-3 rounded-lg bg-[#F8FAFB] border border-[#E7EDEF]">
          <span class="text-slate-400">Entitlements Provided:</span>
          <p class="font-medium text-slate-700 mt-1"><%= record.benefitsProvided || 'One-time resettlement assistance paid' %></p>
        </div>
      </div>

      <% if (['DISTRICT_AUTHORITY', 'CENTRAL_AUTHORITY', 'SUPER_ADMIN'].includes(currentUser.role) && record.acquisitionStatus !== 'CLOSED') { %>
        <div class="pt-4 border-t border-[#E7EDEF] grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Update R&R -->
          <form method="POST" action="/land/<%= record.requestId %>/rnr" class="p-4 rounded-xl bg-[#F8FAFB] border border-[#E7EDEF] space-y-3 text-xs">
            <div class="font-bold text-[#1A2A42]">Update R&R Details:</div>
            <div>
              <label class="block text-slate-500 mb-1">R&R Status</label>
              <select name="rrStatus" class="w-full p-2 border border-[#E7EDEF] rounded">
                <option value="IN_PROGRESS">IN_PROGRESS</option>
                <option value="COMPLETED" selected>COMPLETED</option>
              </select>
            </div>
            <div>
              <label class="block text-slate-500 mb-1">Rehabilitation Notes</label>
              <input type="text" name="benefitsProvided" value="Livelihood grant disbursed, all 1 affected families rehabilitated" class="w-full p-2 border border-[#E7EDEF] rounded" />
            </div>
            <button type="submit" class="px-4 py-2 bg-[#207E85] text-white font-bold rounded-lg hover:bg-[#19656b] transition">
              Save R&R Record
            </button>
          </form>

          <!-- Final Case Closure -->
          <form method="POST" action="/land/<%= record.requestId %>/close" class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 space-y-3 text-xs">
            <div class="font-bold text-emerald-900">Final Statutory Case Closure:</div>
            <p class="text-[11px] text-emerald-700 leading-relaxed">
              Once possession and compensation are complete, close the acquisition case. This permanently locks all records and commits the cryptographic digest to the tamper-proof ledger.
            </p>
            <input type="hidden" name="closingRemarks" value="All statutory acquisition, compensation, and handover stages fully satisfied." />
            <button type="submit" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg shadow-md transition">
              Close Case & Archive on Blockchain ✓
            </button>
          </form>
        </div>
      <% } %>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- TAB 8: Audit Trail & Blockchain Ledger -->
  <!-- ========================================================================= -->
  <div id="tabContent_audit" class="hidden space-y-6">
    <div class="bg-white p-6 rounded-xl border border-[#E7EDEF] shadow-sm space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-[#E7EDEF]">
        <div>
          <h2 class="text-sm font-bold text-[#1A2A42]">Immutable Case Audit Trail</h2>
          <p class="text-[11px] text-slate-400">Chronological history with actor identities, actions, and SHA-256 hashes.</p>
        </div>
        <span class="text-xs font-mono text-slate-500 font-semibold">
          <%= auditLogs ? auditLogs.length : 0 %> Logged Events
        </span>
      </div>

      <% if (auditLogs && auditLogs.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs data-table">
            <thead>
              <tr>
                <th>Timestamp</th>
                <th>Actor / Officer</th>
                <th>Role</th>
                <th>Action</th>
                <th>Details / Remarks</th>
              </tr>
            </thead>
            <tbody>
              <% auditLogs.forEach((log) => { %>
                <tr class="hover:bg-slate-50/70 transition">
                  <td class="font-mono text-slate-500 text-[11px]">
                    <%= log.timestamp ? new Date(log.timestamp).toLocaleString('en-IN') : '—' %>
                  </td>
                  <td class="font-medium text-[#1A2A42] font-mono text-[11px]">
                    <%= log.userId || 'System' %>
                  </td>
                  <td>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#E8F3F4] text-[#207E85]">
                      <%= log.userRole || 'OFFICER' %>
                    </span>
                  </td>
                  <td class="font-bold text-[#1A2A42]">
                    <%= (log.action || '').replace(/_/g, ' ') %>
                  </td>
                  <td class="text-slate-600 text-[11px] max-w-xs truncate" title="<%= JSON.stringify(log.details || {}) %>">
                    <%= (log.details && (log.details.remarks || log.details.projectName || log.details.surveyNumber || log.details.type)) || JSON.stringify(log.details || {}) %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="text-center py-8 text-xs text-slate-400">
          No audit entries recorded yet for this case.
        </div>
      <% } %>
    </div>
  </div>

</div>

<script>
function showTab(tabName) {
  const tabs = ['overview', 'documents', 'approvals', 'statutory', 'compensation', 'possession', 'rnr', 'audit'];
  tabs.forEach(t => {
    const content = document.getElementById('tabContent_' + t);
    const btn = document.getElementById('tabBtn_' + t);
    if (t === tabName) {
      if (content) content.classList.remove('hidden');
      if (btn) btn.className = 'px-3.5 py-2 rounded-lg bg-[#207E85] text-white font-bold transition';
    } else {
      if (content) content.classList.add('hidden');
      if (btn) btn.className = 'px-3.5 py-2 rounded-lg text-slate-600 hover:bg-slate-100 transition';
    }
  });
}

// Auto-navigate to hash on load
window.addEventListener('DOMContentLoaded', () => {
  const hash = window.location.hash.replace('#', '').replace('-section', '').replace('-tab', '');
  if (hash) {
    showTab(hash);
  }
});
</script>
