<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In | LRVS — Land Acquisition & Management System</title>
  
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/styles.css">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            lrvs: {
              navy: '#1A2A42',
              teal: '#207E85',
              tealHover: '#19656b',
              ice: '#F3F8F9',
              white: '#FFFFFF',
              border: '#E7EDEF',
              slate: '#314155',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="min-h-screen flex flex-col md:flex-row bg-[#F8FAFB] text-[#314155] font-sans antialiased">

  <!-- ── LEFT: 50% Deep Navy Branding Panel (Ref: Screenshot 4) ─── -->
  <div class="w-full md:w-1/2 bg-[#1A2A42] flex flex-col justify-between p-8 sm:p-12 relative overflow-hidden min-h-[340px] md:min-h-screen">
    
    <!-- Subtle Concentric Circular Watermark Circles in Background -->
    <div class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full border border-white/5 pointer-events-none"></div>
    <div class="absolute -bottom-16 -left-16 w-80 h-80 rounded-full border border-white/5 pointer-events-none"></div>
    <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full border border-white/5 pointer-events-none"></div>

    <!-- Top Left: LRVS Logo Icon -->
    <div class="relative z-10">
      <div class="w-12 h-12 rounded-xl bg-[#207E85] flex items-center justify-center text-white shadow-md">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 21h18M3 7h18M4 7v14M8 7v14M12 7v14M16 7v14M20 7v14M2 7l10-4 10 4"/>
        </svg>
      </div>
    </div>

    <!-- Centered: Welcome Back + Teal Underline -->
    <div class="my-auto py-12 text-center relative z-10">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-none">
        Welcome
      </h1>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-none mt-2.5">
        Back
      </h1>
      <!-- Exact Teal Horizontal Underline Pill -->
      <div class="w-20 h-1.5 bg-[#207E85] rounded-full mx-auto mt-6"></div>
    </div>

    <!-- Bottom Placeholder for balance -->
    <div class="hidden md:block text-slate-500 text-xs">
      LRVS &middot; SIH 26016
    </div>
  </div>

  <!-- ── RIGHT: 50% Clean Form Panel (Ref: Screenshot 4) ────────── -->
  <div class="w-full md:w-1/2 flex items-center justify-center p-6 sm:p-12 lg:p-16 min-h-full">
    <div class="w-full max-w-md">

      <!-- Alerts / Feedback messages -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-5 p-3.5 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-xs font-medium flex items-center gap-2.5 shadow-sm">
          <svg class="w-4 h-4 text-rose-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <% if (typeof info !== 'undefined' && info) { %>
        <div class="mb-5 p-3.5 rounded-lg bg-blue-50 border border-blue-200 text-blue-700 text-xs font-medium flex items-center gap-2.5 shadow-sm">
          <svg class="w-4 h-4 text-blue-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span><%= info %></span>
        </div>
      <% } %>

      <!-- Form matching exact Screenshot UI -->
      <form action="/login" method="POST" class="space-y-5">

        <!-- User ID Field -->
        <div>
          <label for="login-id" class="block text-xs sm:text-sm font-semibold text-slate-800 mb-1.5">
            User ID <span class="text-rose-500 font-bold">*</span>
          </label>
          <input
            id="login-id"
            name="id"
            type="text"
            required
            autocomplete="username"
            value="<%= typeof id !== 'undefined' ? id : (typeof formId !== 'undefined' ? formId : '') %>"
            placeholder="MH-REV-4471"
            class="w-full px-4 py-2.5 bg-white border border-[#E2E8F0] rounded-lg text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#207E85]/40 focus:border-[#207E85] text-sm transition-all shadow-sm"
          />
        </div>

        <!-- Password Field with Toggle Eye Icon -->
        <div>
          <label for="login-password" class="block text-xs sm:text-sm font-semibold text-slate-800 mb-1.5">
            Password <span class="text-rose-500 font-bold">*</span>
          </label>
          <div class="relative">
            <input
              id="login-password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              placeholder=""
              class="w-full px-4 py-2.5 pr-11 bg-white border border-[#E2E8F0] rounded-lg text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#207E85]/40 focus:border-[#207E85] text-sm transition-all shadow-sm"
            />
            <!-- Password Eye Toggle -->
            <button
              type="button"
              id="togglePasswordBtn"
              onclick="togglePasswordVisibility()"
              class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 transition-colors"
              aria-label="Toggle password visibility"
            >
              <!-- Eye open icon -->
              <svg id="eyeOpenIcon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
              <!-- Eye closed icon -->
              <svg id="eyeClosedIcon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Options: Remember Me & Forgot Password -->
        <div class="flex items-center justify-between text-xs sm:text-sm pt-1">
          <label class="flex items-center gap-2 cursor-pointer select-none">
            <input
              type="checkbox"
              name="remember"
              class="w-4 h-4 rounded text-[#207E85] border-slate-300 focus:ring-[#207E85] focus:ring-offset-0 transition"
            />
            <span class="text-slate-600 font-medium">Remember me</span>
          </label>
          <a href="#" onclick="alert('Password reset link has been dispatched to your official government email.'); return false;" class="text-[#207E85] hover:text-[#185F65] font-medium hover:underline">
            Forgot password?
          </a>
        </div>

        <!-- Large Solid Teal Sign In Button -->
        <button
          type="submit"
          class="w-full py-3 px-4 bg-[#207E85] hover:bg-[#185F65] text-white font-semibold rounded-lg shadow-sm text-sm sm:text-base transition-colors duration-150 mt-6"
        >
          Sign In
        </button>

      </form>

      <!-- Quick Demo Account Fillers for Evaluation Convenience -->
      <div class="mt-6 pt-5 border-t border-[#E2E8F0]">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-3 text-center">
          Demo Accounts — Password: Pass@1234
        </div>
        <div class="grid grid-cols-2 gap-1.5">
          <button type="button" onclick="fillDemo('CENTRAL-001')" class="flex items-center gap-2 px-2.5 py-2 bg-white border border-[#E2E8F0] hover:border-[#207E85] hover:bg-[#F3F8F9] rounded-lg text-xs text-slate-700 font-medium transition-all text-left">
            <span class="w-2 h-2 rounded-full bg-indigo-500 flex-shrink-0"></span>
            <span>Central Ministry</span>
          </button>
          <button type="button" onclick="fillDemo('STATE-001')" class="flex items-center gap-2 px-2.5 py-2 bg-white border border-[#E2E8F0] hover:border-[#207E85] hover:bg-[#F3F8F9] rounded-lg text-xs text-slate-700 font-medium transition-all text-left">
            <span class="w-2 h-2 rounded-full bg-blue-500 flex-shrink-0"></span>
            <span>State Government</span>
          </button>
          <button type="button" onclick="fillDemo('DIST-001')" class="flex items-center gap-2 px-2.5 py-2 bg-white border border-[#E2E8F0] hover:border-[#207E85] hover:bg-[#F3F8F9] rounded-lg text-xs text-slate-700 font-medium transition-all text-left">
            <span class="w-2 h-2 rounded-full bg-sky-500 flex-shrink-0"></span>
            <span>District Authority</span>
          </button>
          <button type="button" onclick="fillDemo('VERIF-001')" class="flex items-center gap-2 px-2.5 py-2 bg-white border border-[#E2E8F0] hover:border-[#207E85] hover:bg-[#F3F8F9] rounded-lg text-xs text-slate-700 font-medium transition-all text-left">
            <span class="w-2 h-2 rounded-full bg-violet-500 flex-shrink-0"></span>
            <span>Verification Officer</span>
          </button>
          <button type="button" onclick="fillDemo('PROJ-001')" class="flex items-center gap-2 px-2.5 py-2 bg-white border border-[#E2E8F0] hover:border-[#207E85] hover:bg-[#F3F8F9] rounded-lg text-xs text-slate-700 font-medium transition-all text-left">
            <span class="w-2 h-2 rounded-full bg-amber-500 flex-shrink-0"></span>
            <span>Approval Officer</span>
          </button>
          <button type="button" onclick="fillDemo('FIN-001')" class="flex items-center gap-2 px-2.5 py-2 bg-white border border-[#E2E8F0] hover:border-[#207E85] hover:bg-[#F3F8F9] rounded-lg text-xs text-slate-700 font-medium transition-all text-left">
            <span class="w-2 h-2 rounded-full bg-emerald-500 flex-shrink-0"></span>
            <span>Finance Officer</span>
          </button>
          <button type="button" onclick="fillDemo('LAND-001')" class="col-span-2 flex items-center gap-2 px-2.5 py-2 bg-[#F3F8F9] border border-[#207E85]/30 hover:border-[#207E85] hover:bg-[#E8F3F4] rounded-lg text-xs text-[#207E85] font-semibold transition-all text-left">
            <span class="w-2 h-2 rounded-full bg-[#207E85] flex-shrink-0"></span>
            <span>Land Owner (Ramesh Patil)</span>
          </button>
        </div>
      </div>

    </div>
  </div>

  <script>
    // Password visibility toggle
    function togglePasswordVisibility() {
      const pwdInput = document.getElementById('login-password');
      const openIcon = document.getElementById('eyeOpenIcon');
      const closedIcon = document.getElementById('eyeClosedIcon');
      if (pwdInput.type === 'password') {
        pwdInput.type = 'text';
        openIcon.classList.add('hidden');
        closedIcon.classList.remove('hidden');
      } else {
        pwdInput.type = 'password';
        openIcon.classList.remove('hidden');
        closedIcon.classList.add('hidden');
      }
    }

    // Quick demo autofill helper
    function fillDemo(userId) {
      document.getElementById('login-id').value = userId;
      document.getElementById('login-password').value = 'Pass@1234';
    }
  </script>
</body>
</html>
